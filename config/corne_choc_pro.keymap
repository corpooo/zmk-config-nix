#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <zmk-helpers/helper.h> // Requires zmk-helpers module.
#include "key-labels/corne-choc-bt-pro.h"

/ {
    chosen { zmk,physical-layout = &five_col_layout; };
};

// #define _BT_SEL_KEYS_                                                        \
//       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR

#define XXX &none
#define ___ &trans

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

#define QUICK_TAP_MS 175

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <50>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

// Hack: Make HRM combos tap-only (cf, ZMK issue #544).
#define ZMK_COMBO_8(NAME, TAP, POS, LAYERS, COMBO_MS, IDLE_MS, HOLD, SIDE)     \
  MAKE_HRM(hm_combo_##NAME, &kp, TAP, SIDE THUMBS)                             \
  ZMK_COMBO_6(NAME, &hm_combo_##NAME HOLD 0, POS, LAYERS, COMBO_MS, IDLE_MS)

// Define mod-morph with a *single* mod trigger for less repetition.
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2)                            \
  ZMK_MOD_MORPH(NAME, mods = <(MOD_L##MOD | MOD_R##MOD)>;                      \
                bindings = <BINDING1>, <BINDING2>;)

#define SHIFT_MORPH(NAME, BINDING1, BINDING2)                                  \
  SIMPLE_MORPH(NAME, SFT, BINDING1, BINDING2)

#include "combos.dtsi" // Must be sourced after HRM-combo hack.

// &caps_word { // Mods deactivate caps-word, requires PR #1451. [TODO: rebase]
//   /delete-property/ ignore-modifiers;
// };

// tap: dot | shft+tap: colon
SHIFT_MORPH(dot_colon, &kp DOT, &kp COLON)
// tap: comma | shft+tap: semi
SHIFT_MORPH(comma_semi, &kp COMMA, &kp SEMI)
// tap: question mark | shft+tap: exclamation mark
SHIFT_MORPH(qmark_emark, &kp QMARK, &kp EXCL)

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
//    ┌─────────────┬─────────────┬─────────────┬─────────────────────────┬──────────┬──────────┐       ┌───────────┬──────────┬───────────────────────────────┬─────────────┬─────────────┬──────────────┐
//    │      Q      │      W      │      E      │            R            │    T     │          │       │           │    Y     │               U               │      I      │      O      │      P       │
//    ├─────────────┼─────────────┼─────────────┼─────────────────────────┼──────────┼──────────┤       ├───────────┼──────────┼───────────────────────────────┼─────────────┼─────────────┼──────────────┤
//    │ &hml lctl A │ &hml lalt S │ &hml lgui D │       &hml lsft F       │    G     │          │       │           │    H     │          &hmr rsft J          │ &hmr rgui K │ &hmr ralt L │ &hmr lctl '  │
//    ├─────────────┼─────────────┼─────────────┼─────────────────────────┼──────────┼──────────┘       └───────────┼──────────┼───────────────────────────────┼─────────────┼─────────────┼──────────────┤
//    │      Z      │      X      │      C      │            V            │    B     │                              │    N     │               M               │ &comma_semi │ &dot_colon  │ &qmark_emark │
//    └─────────────┴─────────────┴─────────────┼─────────────────────────┼──────────┼──────────┐       ┌───────────┼──────────┼───────────────────────────────┼─────────────┴─────────────┴──────────────┘
//                                              │ mt lsft(lctl(lalt)) esc │ lt 3 tab │ lt 2 spc │       │ lt 1 bspc │ lt 3 ent │ mt lsft(lalt(lctl(lgui))) del │
//                                              └─────────────────────────┴──────────┴──────────┘       └───────────┴──────────┴───────────────────────────────┘
  &kp Q          &kp W         &kp E         &kp R                  &kp T       &none                 &none        &kp Y       &kp U                      &kp I         &kp O         &kp P
  &hml LCTRL A   &hml LALT S   &hml LCMD D   &hml LSHFT F           &kp G       &none                 &none        &kp H       &hmr RSHFT J               &hmr RCMD K   &hmr RALT L   &hmr LCTRL SINGLE_QUOTE
  &kp Z          &kp X         &kp C         &kp V                  &kp B                                          &kp N       &kp M                      &comma_semi   &dot_colon    &qmark_emark
                                             &mt LS(LC(LALT)) ESC   &lt 3 TAB   &lt 2 SPACE           &lt 1 BSPC   &lt 3 RET   &mt LS(LA(LC(LCMD))) DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        nums_layer {
            display-name = "NUMS";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │  1  │  2  │  3  │  4  │  5  │     │       │     │  6  │  7  │  8  │  9  │  0  │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤       ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘       └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │                   │     │     │     │     │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┐       ┌─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │       │     │     │     │
//                      └─────┴─────┴─────┘       └─────┴─────┴─────┘
  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &trans           &trans   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                             &trans   &trans   &trans   &trans   &trans
                             &trans   &trans   &trans           &trans   &trans   &trans
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐       ┌─────┬──────┬──────┬─────┬──────┬─────┐
//    │     │     │     │     │     │     │       │     │      │      │     │      │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤       ├─────┼──────┼──────┼─────┼──────┼─────┤
//    │     │     │     │     │     │     │       │     │ left │ down │ up  │ rght │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘       └─────┼──────┼──────┼─────┼──────┼─────┤
//    │     │     │     │     │     │                   │      │      │     │      │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┐       ┌─────┼──────┼──────┼─────┴──────┴─────┘
//                      │     │     │     │       │     │      │      │
//                      └─────┴─────┴─────┘       └─────┴──────┴──────┘
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans     &trans     &trans   &trans      &trans
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &trans
  &trans   &trans   &trans   &trans   &trans                             &trans     &trans     &trans   &trans      &trans
                             &trans   &trans   &trans           &trans   &trans     &trans
            >;
        };

        utils_layer {
            display-name = "UTILS";

            // --------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |
            // | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
//    ┌──────────┬──────────┬────────────┬──────────┬────────────────┬─────┐       ┌─────┬──────┬──────┬──────┬──────┬──────┐
//    │   bri-   │   bri+   │    prev    │   play   │      next      │     │       │     │      │      │ mute │ vold │ volu │
//    ├──────────┼──────────┼────────────┼──────────┼────────────────┼─────┤       ├─────┼──────┼──────┼──────┼──────┼──────┤
//    │ bt_sel 0 │ bt_sel 1 │  bt_sel 2  │ bt_sel 3 │    bt_sel 4    │     │       │     │ left │ down │  up  │ rght │      │
//    ├──────────┼──────────┼────────────┼──────────┼────────────────┼─────┘       └─────┼──────┼──────┼──────┼──────┼──────┤
//    │  bt_clr  │ ug_ tog  │ &sys_reset │   boot   │ &studio_unlock │                   │      │ boot │      │      │      │
//    └──────────┴──────────┴────────────┼──────────┼────────────────┼─────┐       ┌─────┼──────┼──────┼──────┴──────┴──────┘
//                                       │          │                │     │       │     │      │      │
//                                       └──────────┴────────────────┴─────┘       └─────┴──────┴──────┘
  &kp C_BRI_DEC   &kp C_BRI_INC     &kp C_PREV     &kp C_PLAY_PAUSE   &kp C_NEXT       &none            &none    &trans     &trans        &kp C_MUTE   &kp C_VOL_DN   &kp C_VOL_UP
  &bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2   &bt BT_SEL 3       &bt BT_SEL 4     &none            &none    &kp LEFT   &kp DOWN      &kp UP       &kp RIGHT      &trans
  &bt BT_CLR      &rgb_ug RGB_TOG   &sys_reset     &bootloader        &studio_unlock                             &trans     &bootloader   &trans       &trans         &trans
                                                   &trans             &trans           &trans           &trans   &trans     &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  |
            // |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |
            // |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
//    ┌─────┬─────┬─────┬──────┬─────┬──────┐       ┌──────┬─────┬──────┬───┬───┬───┐
//    │  !  │  @  │  #  │  $   │  %  │ lctl │       │ rctl │  ^  │  &   │ * │ ( │ ) │
//    ├─────┼─────┼─────┼──────┼─────┼──────┤       ├──────┼─────┼──────┼───┼───┼───┤
//    │     │     │     │      │     │ lalt │       │ ralt │  -  │  =   │ [ │ ] │ \ │
//    ├─────┼─────┼─────┼──────┼─────┼──────┘       └──────┼─────┼──────┼───┼───┼───┤
//    │     │     │     │      │     │                     │  _  │  +   │ { │ } │ | │
//    └─────┴─────┴─────┼──────┼─────┼──────┐       ┌──────┼─────┼──────┼───┴───┴───┘
//                      │ lgui │     │ spc  │       │ ent  │     │ ralt │
//                      └──────┴─────┴──────┘       └──────┴─────┴──────┘
  &kp EXCL   &kp AT   &kp HASH   &kp DLLR   &kp PRCNT   &kp LCTRL           &kp RCTRL   &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR   &kp RPAR
  &trans     &trans   &trans     &trans     &trans      &kp LALT            &kp RALT    &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT   &kp BSLH
  &trans     &trans   &trans     &trans     &trans                                      &kp UNDER   &kp PLUS    &kp LBRC    &kp RBRC   &kp PIPE
                                 &kp LGUI   &trans      &kp SPACE           &kp RET     &trans      &kp RALT
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤       ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘       └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │                   │     │     │     │     │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┐       ┌─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │       │     │     │     │
//                      └─────┴─────┴─────┘       └─────┴─────┴─────┘
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                             &trans   &trans   &trans   &trans   &trans
                             &trans   &trans   &trans           &trans   &trans   &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤       ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘       └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │                   │     │     │     │     │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┐       ┌─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │       │     │     │     │
//                      └─────┴─────┴─────┘       └─────┴─────┴─────┘
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                             &trans   &trans   &trans   &trans   &trans
                             &trans   &trans   &trans           &trans   &trans   &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤       ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘       └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │                   │     │     │     │     │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┐       ┌─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │       │     │     │     │
//                      └─────┴─────┴─────┘       └─────┴─────┴─────┘
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                             &trans   &trans   &trans   &trans   &trans
                             &trans   &trans   &trans           &trans   &trans   &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤       ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │       │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘       └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │                   │     │     │     │     │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┐       ┌─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │       │     │     │     │
//                      └─────┴─────┴─────┘       └─────┴─────┴─────┘
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans           &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                             &trans   &trans   &trans   &trans   &trans
                             &trans   &trans   &trans           &trans   &trans   &trans
            >;
        };
    };
};
